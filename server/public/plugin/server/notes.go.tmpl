package app

import (
	"errors"
	"strings"
	"time"

	"gorm.io/gorm"
	"sdk"
)

// notes 演示摘要分页、详情读取、排序白名单和批量写入事务。
func (m *demo) notes(c *sdk.Context) {
	var form struct {
		Action       string  `json:"action" default:"list" validate:"oneof=list info create update delete" label:"操作"`
		ID           int64   `json:"id" validate:"min=0" label:"记录ID"`
		IDs          []int64 `json:"ids" validate:"omitempty,max=10000,dive,min=1" label:"记录ID列表"`
		Keyword      string  `json:"keyword" validate:"max=100" label:"关键词"`
		Page         int     `json:"page" default:"1" validate:"min=1,max=100000" label:"页码"`
		PageSize     int     `json:"page_size" default:"10" validate:"min=1,max=100" label:"每页条数"`
		OrderByField string  `json:"order_by_field" default:"id" validate:"oneof=id title create_time update_time" label:"排序字段"`
		OrderByType  string  `json:"order_by_type" default:"desc" validate:"oneof=asc desc" label:"排序方向"`
		Title        string  `json:"title" validate:"max=100" label:"标题"`
		Content      string  `json:"content" validate:"max=10000" label:"内容"`
	}
	if ok, message := c.ValidatorAll(&form); !ok {
		c.Error(message)
		return
	}
	db := m.app.Database.Db.WithContext(c.Request.Context())
	if form.Action == "list" {
		query := db.Table(m.table)
		if keyword := strings.TrimSpace(form.Keyword); keyword != "" {
			query = query.Where("title LIKE ? OR content LIKE ?", "%"+keyword+"%", "%"+keyword+"%")
		}
		var total int64
		if err := query.Count(&total).Error; err != nil {
			c.Error(err.Error())
			return
		}
		// 排序参数经过白名单校验；相同值再按 ID 排序，保持翻页顺序稳定。
		query = query.Order(form.OrderByField + " " + form.OrderByType)
		if form.OrderByField != "id" {
			query = query.Order("id " + form.OrderByType)
		}
		list := make([]NoteSummary, 0)
		if err := query.Select("id, title, create_time, update_time").Offset((form.Page - 1) * form.PageSize).Limit(form.PageSize).Find(&list).Error; err != nil {
			c.Error(err.Error())
			return
		}
		c.SuccessWithData("获取成功", map[string]interface{}{
			"list":      list,
			"total":     total,
			"page":      form.Page,
			"page_size": form.PageSize,
		})
		return
	}
	if form.Action == "delete" {
		ids := form.IDs
		if len(ids) == 0 && form.ID > 0 {
			ids = []int64{form.ID}
		}
		if len(ids) == 0 {
			c.Error("请选择记录")
			return
		}
		// 分批限制单条 SQL 的参数量，所有批次共用事务，任一失败全部回滚。
		err := db.Transaction(func(tx *gorm.DB) error {
			return m.app.Database.BatchExecute(ids, 1000, func(batch interface{}) error {
				return tx.Table(m.table).Where("id IN ?", batch.([]int64)).Delete(&Note{}).Error
			})
		})
		if err != nil {
			c.Error(err.Error())
			return
		}
		// 已删除或不存在的 ID 无需报错，重复提交删除也安全。
		c.Success("删除成功")
		return
	}
	if form.Action != "create" && form.ID <= 0 {
		c.Error("请选择记录")
		return
	}
	if form.Action == "info" {
		var record Note
		err := db.Table(m.table).Where("id = ?", form.ID).Limit(1).Find(&record).Error
		if err != nil {
			c.Error(err.Error())
			return
		}
		if record.ID <= 0 {
			c.Error("记录不存在，请刷新列表")
			return
		}
		c.SuccessWithData("获取成功", record)
		return
	}
	title := strings.TrimSpace(form.Title)
	if title == "" {
		c.Error("请填写标题")
		return
	}
	now := time.Now().Format("2006-01-02 15:04:05")
	record := Note{
		Title:      title,
		Content:    form.Content,
		CreateTime: now,
		UpdateTime: now,
	}
	// 事务内的所有写入使用 tx；关联记录也可放入同一事务，失败自动回滚。
	err := db.Transaction(func(tx *gorm.DB) error {
		if form.Action == "create" {
			return tx.Table(m.table).Create(&record).Error
		}
		query := tx.Table(m.table).Where("id = ?", form.ID).
			Updates(map[string]interface{}{
				"title":       title,
				"content":     form.Content,
				"update_time": now,
			})
		if query.Error != nil {
			return query.Error
		}
		if query.RowsAffected == 0 {
			return errors.New("记录不存在，请刷新列表")
		}
		return nil
	})
	if err != nil {
		c.Error(err.Error())
		return
	}
	if form.Action == "create" {
		c.SuccessWithData("添加成功", map[string]int64{"id": record.ID})
		return
	}
	c.Success("操作成功")
}
